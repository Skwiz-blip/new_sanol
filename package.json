{
  "name": "@sanol/groupe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site du GROUPE SANOU SA (React + Vite + GSAP), prerendu en pages statiques.",
  "scripts": {
    "dev": "vite --port 5190",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:spa": "vite build",
    "preview": "node scripts/serve.mjs",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "animejs": "4.2.2",
    "gsap": "3.13.0",
    "lenis": "1.3.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
